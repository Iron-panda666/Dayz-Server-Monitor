<UserControl x:Class="MagDeer.App.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MagDeer.App" UseLayoutRounding="True" SnapsToDevicePixels="True" TextBlock.TextAlignment="Center">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style x:Key="DashboardLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="FontSize" Value="14"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="DetailLine" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
  </UserControl.Resources>
  <local:DashboardPanel x:Name="Surface" Margin="5" ClipToBounds="True">
    <Viewbox local:DashboardPanel.Role="Server" Stretch="Uniform" StretchDirection="DownOnly"><Grid x:Name="ServerDesign" Width="760"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ServerLabel" Text="{DynamicResource L.Server}" Style="{StaticResource DashboardLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/><ComboBox x:Name="ServerSelector" Grid.Column="1" FontSize="14" Margin="0" Padding="6,3" SelectionChanged="ServerSelectionChanged" ToolTip="{DynamicResource L.SelectServerTip}"/></Grid></Viewbox>
    <Border local:DashboardPanel.Role="Clock" Style="{StaticResource Tile}">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Grid x:Name="ClockDesign" Width="640"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="ClockMain" VerticalAlignment="Center">
          <TextBlock x:Name="ClockHeading" Text="{DynamicResource L.PragueClock}" Style="{StaticResource DashboardLabel}"/>
          <TextBlock x:Name="ClockText" Text="00:00" FontFamily="Segoe UI Light" FontSize="94" LineHeight="104" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/>
          <TextBlock x:Name="DateText" Foreground="{DynamicResource MutedBrush}" FontSize="17"/>
        </StackPanel>
        <StackPanel x:Name="ClockDetails" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border x:Name="PlanBadge" CornerRadius="4" Padding="8,4"><TextBlock x:Name="PlanBadgeText" FontSize="13" FontWeight="SemiBold"/></Border>
          <StackPanel x:Name="ClockExtras" Margin="0,10,0,0">
            <TextBlock x:Name="ServerClockText" Text="N/A" Foreground="{DynamicResource MutedBrush}" FontSize="16"/>
            <TextBlock x:Name="OffsetLabel" Style="{StaticResource DetailLine}"/>
            <Grid x:Name="ClockSourcePanel" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="ClockSourceText" Text="{DynamicResource L.ClockWindows}" Style="{StaticResource DetailLine}"/><TextBlock x:Name="NtpDetailText" Style="{StaticResource DetailLine}" Visibility="Collapsed"/></StackPanel>
              <Button Grid.Column="1" x:Name="SyncNowButton" Content="{DynamicResource L.SyncNow}" ToolTip="{DynamicResource L.SyncNowTip}" Click="SyncNowClick" FontSize="13" Padding="8,3" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="SessionText" Style="{StaticResource DetailLine}" FontSize="14" Margin="0,7,0,0" ToolTip="{DynamicResource L.SessionHelp}"/>
          </StackPanel>
        </StackPanel>
      </Grid></Viewbox>
    </Border>
    <Border local:DashboardPanel.Role="Restart" Style="{StaticResource Tile}">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="CountdownDesign" Width="600">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="CountdownLabel" Text="{DynamicResource L.Countdown}" Style="{StaticResource DashboardLabel}"/><TextBlock x:Name="CountdownText" Text="00:00:00" FontFamily="Consolas" FontSize="76" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,4" TextWrapping="NoWrap"/></StackPanel>
          <StackPanel x:Name="NextRestartPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{DynamicResource L.NextRestart}" Style="{StaticResource DashboardLabel}"/><TextBlock x:Name="NextRestartText" Text="19:00" FontSize="34" FontWeight="Light"/><TextBlock x:Name="NextDateText" Foreground="{DynamicResource MutedBrush}" FontSize="13"/></StackPanel>
        </Grid>
        <TextBlock x:Name="CompactNextRestart" Foreground="{DynamicResource MutedBrush}" FontSize="15" Visibility="Collapsed"/>
        <StackPanel x:Name="RestartExtras">
          <Border Background="{DynamicResource DeepBrush}" CornerRadius="5" Padding="10,7" Margin="0,4,0,8"><TextBlock x:Name="WarningText" Text="{DynamicResource L.WarnNormal}" Foreground="{DynamicResource MutedBrush}" FontSize="14"/></Border>
          <Grid x:Name="ReminderTimes"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="LogoutText" Text="N/A" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><TextBlock Grid.Column="1" x:Name="KickText" Text="N/A" Foreground="{DynamicResource MutedBrush}" FontSize="14"/></Grid>
        </StackPanel>
      </StackPanel></Viewbox>
    </Border>
    <Border local:DashboardPanel.Role="Status" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="StatusDesign" Width="260">
      <TextBlock x:Name="StatusLabel" Text="{DynamicResource L.ServerStatus}" Style="{StaticResource DashboardLabel}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="QUERY UNAVAILABLE" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="24" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel>
      <TextBlock x:Name="StatusHint" Text="{DynamicResource L.Waiting}" Style="{StaticResource DetailLine}" Margin="0,5,0,0"/>
    </StackPanel></Viewbox></Border>
    <Border local:DashboardPanel.Role="Players" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><local:PlayerCountDisplay x:Name="PlayerCounts" Width="190"/></Viewbox></Border>
    <Border local:DashboardPanel.Role="Rtt" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="RttDesign" Width="180">
      <TextBlock x:Name="RttLabel" Text="UDP QUERY RTT" Style="{StaticResource DashboardLabel}"/><TextBlock x:Name="RttText" Text="N/A" Foreground="{DynamicResource MetricBrush}" FontSize="38" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="NoWrap"/><TextBlock x:Name="RttHint" Text="{DynamicResource L.Challenge}" Style="{StaticResource DetailLine}"/>
    </StackPanel></Viewbox></Border>
    <Border local:DashboardPanel.Role="History" x:Name="ExtendedPanel" Style="{StaticResource Tile}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource L.HistoryTitle}" Style="{StaticResource DashboardLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><local:PlayerChart Grid.Row="1" x:Name="Chart" Margin="0,4,0,0" MinHeight="0"/></Grid></Border>
    <Border local:DashboardPanel.Role="Details" Style="{StaticResource Tile}" Background="{DynamicResource BackgroundBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" VerticalContentAlignment="Center">
        <StackPanel x:Name="InfoDesign" VerticalAlignment="Center">
          <Grid x:Name="InfoTimes"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="LastUpdateText" Text="N/A" Style="{StaticResource DetailLine}" FontSize="14"/><TextBlock Grid.Column="1" x:Name="PollText" Text="{DynamicResource L.Polling}" Style="{StaticResource DetailLine}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/></Grid>
          <TextBlock x:Name="DetailText" Style="{StaticResource DetailLine}" Margin="0,5,0,0"/>
          <Border x:Name="RecoveryPanel" Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="4" Padding="6" Margin="0,5,0,0" Visibility="Collapsed"><TextBlock x:Name="RecoveryText" Foreground="{DynamicResource SuccessBrush}" FontSize="14"/></Border>
          <TextBlock x:Name="ServerNameText" Style="{StaticResource DetailLine}" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
          <TextBlock x:Name="EndpointText" Style="{StaticResource DetailLine}"/>
          <TextBlock x:Name="StorageErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="14" Visibility="Collapsed"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border local:DashboardPanel.Role="World" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><local:WorldClockStrip x:Name="WorldClocksPanel" Width="760"/></Viewbox></Border>
  </local:DashboardPanel>
</UserControl>
