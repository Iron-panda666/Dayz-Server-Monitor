<UserControl x:Class="MagDeer.App.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MagDeer.App" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="8"/></Style>
  </UserControl.Resources>
  <local:DashboardPanel x:Name="Surface" Margin="5" ClipToBounds="True">
    <Viewbox local:DashboardPanel.Role="Server" Stretch="Uniform"><Grid Width="760"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.Server}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0,12,0"/><ComboBox x:Name="ServerSelector" Grid.Column="1" Margin="0" Padding="6,3" SelectionChanged="ServerSelectionChanged" ToolTip="{DynamicResource L.SelectServerTip}"/></Grid></Viewbox>
    <Border local:DashboardPanel.Role="Clock" Style="{StaticResource Tile}">
      <Viewbox Stretch="Uniform"><Grid x:Name="ClockDesign" Width="640"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource L.PragueClock}" Style="{StaticResource Label}"/><TextBlock x:Name="ClockText" Text="00:00" FontFamily="Segoe UI Light" FontSize="94" LineHeight="104" LineStackingStrategy="BlockLineHeight"/><TextBlock x:Name="DateText" Foreground="{DynamicResource MutedBrush}" FontSize="15"/></StackPanel>
        <StackPanel x:Name="ClockDetails" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><Border x:Name="PlanBadge" CornerRadius="4" Padding="8,4"><TextBlock x:Name="PlanBadgeText" FontSize="10" FontWeight="SemiBold"/></Border>
        <StackPanel x:Name="ClockExtras" Margin="0,12,0,0"><TextBlock x:Name="ServerClockText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><TextBlock x:Name="OffsetLabel" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ClockSourceText" Text="{DynamicResource L.ClockWindows}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="NtpDetailText" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Visibility="Collapsed"/></StackPanel><Button Grid.Column="1" x:Name="SyncNowButton" Content="{DynamicResource L.SyncNow}" ToolTip="{DynamicResource L.SyncNowTip}" Click="SyncNowClick" FontSize="11" Padding="8,3" Visibility="Collapsed"/></Grid>
        <TextBlock x:Name="SessionText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" ToolTip="{DynamicResource L.SessionHelp}"/></StackPanel></StackPanel>
      </Grid></Viewbox>
    </Border>
    <Border local:DashboardPanel.Role="Restart" Style="{StaticResource Tile}">
      <Viewbox Stretch="Uniform"><StackPanel x:Name="CountdownDesign" Width="600">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CountdownLabel" Text="{DynamicResource L.Countdown}" Style="{StaticResource Label}"/><TextBlock x:Name="CountdownText" Text="00:00:00" FontFamily="Consolas" FontSize="76" Foreground="{DynamicResource AccentBrush}" Margin="-3,4,0,4"/></StackPanel><StackPanel x:Name="NextRestartPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{DynamicResource L.NextRestart}" Style="{StaticResource Label}" HorizontalAlignment="Right"/><TextBlock x:Name="NextRestartText" Text="19:00" FontSize="32" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock x:Name="NextDateText" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid>
        <TextBlock x:Name="CompactNextRestart" Foreground="{DynamicResource MutedBrush}" FontSize="14" Visibility="Collapsed"/><StackPanel x:Name="RestartExtras"><Border Background="{DynamicResource DeepBrush}" CornerRadius="5" Padding="10,7" Margin="0,4,0,8"><TextBlock x:Name="WarningText" Text="{DynamicResource L.WarnNormal}" Foreground="{DynamicResource MutedBrush}" FontSize="13"/></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="LogoutText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="KickText" Text="—" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" FontSize="12"/></Grid></StackPanel>
      </StackPanel></Viewbox>
    </Border>
    <Border local:DashboardPanel.Role="Status" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform"><StackPanel x:Name="StatusDesign" Width="260"><TextBlock x:Name="StatusLabel" Text="{DynamicResource L.ServerStatus}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="QUERY UNAVAILABLE" FontWeight="SemiBold" FontSize="19"/></StackPanel><TextBlock x:Name="StatusHint" Text="{DynamicResource L.Waiting}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" FontSize="12"/></StackPanel></Viewbox></Border>
    <Border local:DashboardPanel.Role="Players" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform"><local:PlayerCountDisplay x:Name="PlayerCounts" Width="190"/></Viewbox></Border>
    <Border local:DashboardPanel.Role="Rtt" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform"><StackPanel x:Name="RttDesign" Width="180"><TextBlock x:Name="RttLabel" Text="UDP QUERY RTT" Style="{StaticResource Label}"/><TextBlock x:Name="RttText" Text="N/A" Foreground="{DynamicResource MetricBrush}" FontSize="34" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="RttHint" Text="{DynamicResource L.Challenge}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Viewbox></Border>
    <Border local:DashboardPanel.Role="History" x:Name="ExtendedPanel" Style="{StaticResource Tile}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource L.HistoryTitle}" Style="{StaticResource Label}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><local:PlayerChart Grid.Row="1" x:Name="Chart" Margin="0,4,0,0" MinHeight="0"/></Grid></Border>
    <Border local:DashboardPanel.Role="Details" Style="{StaticResource Tile}" Background="{DynamicResource BackgroundBrush}"><Viewbox Stretch="Uniform"><StackPanel x:Name="InfoDesign" Width="650"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LastUpdateText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="PollText" Text="{DynamicResource L.Polling}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Grid><TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/><Border x:Name="RecoveryPanel" Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="4" Padding="6" Margin="0,5,0,0" Visibility="Collapsed"><TextBlock x:Name="RecoveryText" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/></Border><TextBlock x:Name="ServerNameText" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,5,0,2"/><TextBlock x:Name="EndpointText" Foreground="{DynamicResource SubtleBrush}" FontSize="10"/><TextBlock x:Name="StorageErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Visibility="Collapsed"/></StackPanel></Viewbox></Border>
    <Border local:DashboardPanel.Role="World" Style="{StaticResource Tile}"><Viewbox Stretch="Uniform"><local:WorldClockStrip x:Name="WorldClocksPanel" Width="760"/></Viewbox></Border>
  </local:DashboardPanel>
</UserControl>
