<Window x:Class="MagDeer.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource L.SettingsTitle}" Style="{StaticResource {x:Type Window}}" Width="720" Height="800" MinWidth="280" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="{DynamicResource L.SettingsHeading}" FontSize="26" FontWeight="Light"/><TextBlock Text="{DynamicResource L.SettingsIntro}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
    <TabControl Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="0,14,0,0">
      <TabItem Header="{DynamicResource L.ServerTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,4,18,8">
          <TextBlock Text="{DynamicResource L.SavedServers}"/>
          <ComboBox x:Name="ProfilesBox" SelectionChanged="ProfileSelected"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="{DynamicResource L.LoadSelected}" Click="LoadProfileClick" Margin="0,0,8,0"/><Button Content="{DynamicResource L.NewServer}" Click="NewProfileClick" Margin="0,0,8,0"/><Button Content="{DynamicResource L.StoreServer}" Click="StoreProfileClick"/></StackPanel>
          <TextBlock Text="{DynamicResource L.ServerIntro}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <TextBlock Text="{DynamicResource L.ServerName}"/><TextBox x:Name="NameBox"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.IpAddress}"/><TextBox x:Name="IpBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.GamePort}"/><TextBox x:Name="GamePortBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L.QueryPort}"/><TextBox x:Name="QueryPortBox"/></StackPanel></Grid>
          <TextBlock Text="{DynamicResource L.GenerateHeading}" FontSize="17" Margin="0,4,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.EveryHours}"/><TextBox x:Name="EveryHoursBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.Anchor}"/><TextBox x:Name="AnchorBox"/></StackPanel><Button Grid.Column="2" Content="{DynamicResource L.Generate}" Click="GenerateClick" VerticalAlignment="Center"/></Grid>
          <TextBlock Text="{DynamicResource L.Schedule}"/><TextBox x:Name="ScheduleBox" ToolTip="{DynamicResource L.ScheduleTip}"/>
          <CheckBox x:Name="ConfirmedBox" Content="{DynamicResource L.ConfirmPlan}"/>
          <TextBlock Text="{DynamicResource L.ConfirmNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>
          <TextBlock Text="{DynamicResource L.WarningMinutes}" FontSize="17" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.LogoutMinutes}"/><TextBox x:Name="LogoutMinutesBox" PreviewKeyDown="MinutesKeyDown" ToolTip="{DynamicResource L.LogoutTip}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource L.KickMinutes}"/><TextBox x:Name="KickMinutesBox" PreviewKeyDown="MinutesKeyDown" ToolTip="{DynamicResource L.KickTip}"/></StackPanel></Grid>
          <TextBlock Text="{DynamicResource L.MinuteNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <TextBlock Text="{DynamicResource L.Intervals}" FontSize="17" Margin="0,0,0,9"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.NormalMode}"/><TextBox x:Name="NormalBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.BeforeInterval}"/><TextBox x:Name="BeforeBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource L.DuringInterval}"/><TextBox x:Name="DuringBox"/></StackPanel></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.Timeout}"/><TextBox x:Name="TimeoutBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource L.FailureThreshold}"/><TextBox x:Name="FailuresBox"/></StackPanel></Grid>
          <Border Background="{DynamicResource WarningSurfaceBrush}" Padding="12" CornerRadius="6"><TextBlock Text="{DynamicResource L.UdpNote}" Foreground="{DynamicResource WarningBrush}" FontSize="12"/></Border>
          <CheckBox x:Name="OfflineBox" Content="{DynamicResource L.ConfirmOffline}" ToolTip="{DynamicResource L.OfflineTip}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource L.DisplayTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,4,18,8">
          <TextBlock Text="{DynamicResource L.Theme}"/><ComboBox x:Name="ThemeBox" DisplayMemberPath="Label"/>
          <TextBlock Text="{DynamicResource L.ThemeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <TextBlock Text="{DynamicResource L.DisplayProfile}"/><ComboBox x:Name="DisplayProfileBox" DisplayMemberPath="Label"/>
          <TextBlock Text="{DynamicResource L.DisplayProfileHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <CheckBox x:Name="MinimizeCloseBox" Content="{DynamicResource L.MinimizeOnClose}"/>
          <TextBlock Text="{DynamicResource L.MinimizeTarget}"/><ComboBox x:Name="MinimizeTargetBox" DisplayMemberPath="Label"/>
          <TextBlock Text="{DynamicResource L.CloseHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <TextBlock Text="{DynamicResource L.Language}"/><ComboBox x:Name="LanguageBox" DisplayMemberPath="Label"/>
          <TextBlock Text="{DynamicResource L.LanguageNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
          <CheckBox x:Name="NtpEnabledBox" Content="{DynamicResource L.NtpEnabled}"/>
          <TextBlock Text="{DynamicResource L.NtpPreset}"/><ComboBox x:Name="NtpPresetBox" SelectionChanged="NtpPresetSelected"/>
          <TextBlock Text="{DynamicResource L.NtpServer}"/><TextBox x:Name="NtpServerBox"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.NtpInterval}"/><TextBox x:Name="NtpIntervalBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource L.NtpTimeout}"/><TextBox x:Name="NtpTimeoutBox"/></StackPanel></Grid>
          <TextBlock Text="{DynamicResource L.NtpHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,20"/>
          <TextBlock Text="{DynamicResource L.Monitor}"/><ComboBox x:Name="MonitorBox" DisplayMemberPath="Label"/>
          <TextBlock Text="{DynamicResource L.MonitorNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>
          <CheckBox x:Name="TopBox" Content="{DynamicResource L.AlwaysTop}"/><CheckBox x:Name="CompactBox" Content="{DynamicResource L.CompactOption}"/>
          <CheckBox x:Name="Clock24Box" Content="{DynamicResource L.Clock24}"/>
          <CheckBox x:Name="ServerClockBox" Content="{DynamicResource L.OffsetClockOption}"/>
          <TextBlock Text="{DynamicResource L.Offset}" Margin="0,14,0,0"/><TextBox x:Name="OffsetBox"/>
          <TextBlock Text="{DynamicResource L.OffsetHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <TextBlock Text="{DynamicResource L.FullscreenHelp}" Margin="0,24,0,0" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource L.ClocksTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,4,18,8">
          <TextBlock Text="{DynamicResource L.WorldIntro}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14"/>
          <ListBox x:Name="ClockList" Height="135" Margin="0,0,0,10" SelectionChanged="ClockSelected"/>
          <WrapPanel Margin="0,0,0,15"><Button Content="{DynamicResource L.RemoveClock}" Click="RemoveClockClick" Margin="0,0,8,5"/><Button Content="{DynamicResource L.MoveUp}" Click="ClockUpClick" Margin="0,0,8,5"/><Button Content="{DynamicResource L.MoveDown}" Click="ClockDownClick" Margin="0,0,8,5"/></WrapPanel>
          <TextBlock Text="{DynamicResource L.Preset}"/><ComboBox x:Name="ClockPresetBox" SelectionChanged="ClockPresetSelected"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource L.City}"/><TextBox x:Name="CityBox" MaxLength="40"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource L.Country}"/><TextBox x:Name="CountryBox" MaxLength="8"/></StackPanel></Grid>
          <TextBlock Text="{DynamicResource L.TimeZone}"/><ComboBox x:Name="TimeZoneBox" DisplayMemberPath="Label"/>
          <CheckBox x:Name="ClockEnabledBox" Content="{DynamicResource L.ClockEnabled}" IsChecked="True"/>
          <WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource L.AddClock}" Click="AddClockClick" Margin="0,0,8,5"/><Button Content="{DynamicResource L.UpdateClock}" Click="UpdateClockClick" Margin="0,0,8,5"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource L.AlertsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,4,18,8">
          <CheckBox x:Name="VisualBox" Content="{DynamicResource L.VisualAlerts}"/>
          <CheckBox x:Name="SoundBox" Content="{DynamicResource L.SoundAlerts}"/>
          <CheckBox x:Name="NotifyBox" Content="{DynamicResource L.Notifications}"/>
          <TextBlock Text="{DynamicResource L.NotificationNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,20"/>
          <CheckBox x:Name="StartupBox" Content="{DynamicResource L.Startup}"/>
          <TextBlock Text="{DynamicResource L.StartupNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,20"/>
          <TextBlock Text="{DynamicResource L.Retention}"/><TextBox x:Name="RetentionBox"/>
          <TextBlock Text="{DynamicResource L.HistoryHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <Button Content="{DynamicResource L.OpenData}" HorizontalAlignment="Left" Click="OpenDataClick" Margin="0,18,0,12"/>
          <TextBlock x:Name="DataPathText" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{DynamicResource L.Cancel}" IsCancel="True" Margin="0,0,10,0"/><Button Content="{DynamicResource L.SaveSettings}" IsDefault="True" Background="{DynamicResource AccentButtonBrush}" BorderBrush="{DynamicResource BorderBrush}" Click="SaveClick"/></StackPanel>
  </Grid>
</Window>
