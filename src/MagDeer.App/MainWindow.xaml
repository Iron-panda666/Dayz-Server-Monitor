<Window x:Class="MagDeer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MagDeer.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Dayz Server Monitor" Icon="Assets/app.ico" Style="{StaticResource {x:Type Window}}" Width="850" Height="890" MinWidth="460" MinHeight="400" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="OnLoaded" Closing="OnClosing" KeyDown="OnKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Grid Background="{DynamicResource HeaderBrush}" MouseLeftButtonDown="DragHeader">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="23,0">
          <Image Source="Assets/app.ico" Width="32" Height="32" Margin="0,0,12,0"/>
          <TextBlock Text="Dayz Server Monitor" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button Content="—" ToolTip="{DynamicResource L.Minimize}" AutomationProperties.Name="{DynamicResource L.Minimize}" Click="MinimizeClick" Padding="12,6" Margin="2"/>
          <Button Content="□" ToolTip="{DynamicResource L.Maximize}" AutomationProperties.Name="{DynamicResource L.Maximize}" Click="MaximizeClick" Padding="12,6" Margin="2"/>
          <Button Content="×" ToolTip="{DynamicResource L.Close}" AutomationProperties.Name="{DynamicResource L.Close}" Click="CloseClick" Padding="12,6" Margin="2"/>
        </StackPanel>
      </Grid>
      <Viewbox Grid.Row="1" Margin="24,8,24,8" Stretch="Uniform">
        <StackPanel Width="760">
          <Grid Margin="4,0,4,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.Server}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="ServerSelector" Grid.Column="1" Margin="0" SelectionChanged="ServerSelectionChanged" ToolTip="{DynamicResource L.SelectServerTip}"/></Grid>
          <Grid Margin="4,0,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource L.PragueClock}" Style="{StaticResource Label}"/>
              <TextBlock x:Name="ClockText" Text="00:00" FontFamily="Segoe UI Light" FontSize="108" LineHeight="112" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock x:Name="DateText" Foreground="{DynamicResource MutedBrush}" FontSize="15"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border x:Name="PlanBadge" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="5" Padding="10,6"><TextBlock x:Name="PlanBadgeText" Text="{DynamicResource L.PlanUnconfirmed}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
              <TextBlock x:Name="ServerClockText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,13,0,0" HorizontalAlignment="Right"/>
              <TextBlock Text="—" x:Name="OffsetLabel" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
          <Grid Margin="4,0,4,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ClockSourceText" Text="{DynamicResource L.ClockWindows}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="NtpDetailText" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,3,0,0" Visibility="Collapsed"/></StackPanel><Button Grid.Column="1" x:Name="SyncNowButton" Content="{DynamicResource L.SyncNow}" ToolTip="{DynamicResource L.SyncNowTip}" Click="SyncNowClick" FontSize="11" Padding="9,5" Margin="12,0,0,0" Visibility="Collapsed"/></Grid>
          <local:WorldClockStrip x:Name="WorldClocksPanel" Margin="0,0,0,8" Visibility="Collapsed"/>
          <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource BorderBrush}" Padding="24,20">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="CountdownLabel" Text="{DynamicResource L.Countdown}" Style="{StaticResource Label}"/><TextBlock x:Name="CountdownText" Text="00:00:00" FontFamily="Consolas" FontSize="80" Foreground="{DynamicResource AccentBrush}" Margin="-3,6,0,6"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{DynamicResource L.NextRestart}" Style="{StaticResource Label}" HorizontalAlignment="Right"/><TextBlock x:Name="NextRestartText" Text="19:00" FontSize="37" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock x:Name="NextDateText" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/></StackPanel>
              </Grid>
              <Border Background="{DynamicResource DeepBrush}" CornerRadius="6" Padding="12,9" Margin="0,2,0,12"><TextBlock x:Name="WarningText" Text="{DynamicResource L.WarnNormal}" Foreground="{DynamicResource MutedBrush}" FontSize="14"/></Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="LogoutText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="13"/><TextBlock Grid.Column="1" x:Name="KickText" Text="—" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" FontSize="13"/></Grid>
            </StackPanel>
          </Border>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="{DynamicResource L.ServerStatus}" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="QUERY UNAVAILABLE" FontWeight="SemiBold" FontSize="17"/></StackPanel><TextBlock x:Name="StatusHint" Text="{DynamicResource L.Waiting}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" FontSize="12"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="{DynamicResource L.Players}" Style="{StaticResource Label}"/><TextBlock x:Name="PlayersText" Text="N/A" Foreground="{DynamicResource MetricBrush}" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.Capacity}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17"><StackPanel><TextBlock Text="UDP QUERY RTT" Style="{StaticResource Label}"/><TextBlock x:Name="RttText" Text="N/A" Foreground="{DynamicResource MetricBrush}" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource L.Challenge}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
          </Grid>
          <Grid Margin="3,12,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LastUpdateText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="PollText" Text="{DynamicResource L.Polling}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Grid>
          <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="3,7,3,0"/>
          <Border x:Name="RecoveryPanel" Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="7" Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="RecoveryText" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/></Border>
          <StackPanel x:Name="ExtendedPanel" Margin="0,19,0,0">
            <Grid Margin="3,0,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.HistoryTitle}" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{DynamicResource L.HistoryNote}" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/></Grid>
            <Border Style="{StaticResource Card}" Padding="12,8"><local:PlayerChart x:Name="Chart" Height="134"/></Border>
            <TextBlock x:Name="ServerNameText" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="3,14,3,3"/>
            <TextBlock x:Name="EndpointText" Foreground="{DynamicResource SubtleBrush}" FontSize="12" Margin="3,0,3,0"/>
          </StackPanel>
          <TextBlock x:Name="StorageErrorText" Foreground="{DynamicResource DangerBrush}" Margin="3,10,3,0" FontSize="12" Visibility="Collapsed"/>
        </StackPanel>
      </Viewbox>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource HeaderBrush}">
        <UniformGrid Columns="4" Margin="15,4">
          <Button x:Name="RefreshButton" Content="{DynamicResource L.Refresh}" Click="RefreshClick" Padding="5,4" Margin="2,0" ToolTip="{DynamicResource L.RefreshTip}"/>
          <Button Content="{DynamicResource L.Compact}" Click="CompactClick" Padding="5,4" Margin="2,0"/>
          <Button Content="{DynamicResource L.Fullscreen}" Click="FullscreenClick" Padding="5,4" Margin="2,0" ToolTip="{DynamicResource L.FullscreenTip}"/>
          <Button Content="{DynamicResource L.Settings}" Click="SettingsClick" Padding="5,4" Margin="2,0"/>
        </UniformGrid>
      </Border>
    </Grid>
  </Border>
</Window>
